{
  "name": "@orbit/cli",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=23 <24"
  },
  "bin": {
    "orbit": "dist/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --config vitest.config.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@orbit/core": "*",
    "@orbit/build": "*",
    "esbuild": "^0.24.0"
  },
  "devDependencies": {
    "typescript": "*",
    "vitest": "*"
  }
}
