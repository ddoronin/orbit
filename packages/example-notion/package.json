{
  "name": "@orbitstack/example-notion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npm run build:web && tsc",
    "build:web": "vite build",
    "dev:web": "vite build --watch",
    "dev:worker": "wrangler dev",
    "serve:web": "vite",
    "test": "vitest run --config vitest.config.ts",
    "dev": "npm run build:web && node ./scripts/dev.mjs",
    "deploy": "npm run build:web && wrangler deploy",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@orbitstack/app": "*",
    "@orbitstack/queues": "*",
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fractional-indexing": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "*",
    "@orbitstack/testing": "*",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.16",
    "tw-animate-css": "^1.4.0",
    "typescript": "*",
    "vite": "^5.4.19",
    "vitest": "*",
    "wrangler": "^3.90.0"
  }
}
