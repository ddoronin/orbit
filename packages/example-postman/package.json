{
  "name": "@orbitstack/example-postman",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npm run build:web && tsc",
    "build:web": "vite build",
    "dev:web": "vite build --watch",
    "dev:worker": "wrangler dev",
    "serve:web": "vite",
    "test": "vitest run --config vitest.config.ts",
    "dev": "npm run build:web && node ./scripts/dev.mjs",
    "deploy": "npm run build:web && wrangler deploy",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@orbitstack/app": "*",
    "@uiw/react-codemirror": "^4.25.10",
    "lucide-react": "^1.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "*",
    "@orbitstack/testing": "*",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^27.0.1",
    "typescript": "*",
    "vite": "^5.4.19",
    "vitest": "*",
    "wrangler": "^4.95.0"
  }
}
